{
  "name": "@medresearch/dsh-medical-e2e",
  "version": "1.1.0",
  "description": "Keyless end-to-end chains over the real Med Research services",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*"
