{
  "name": "@medresearch/dsh-medical-storage",
  "version": "1.1.0",
  "description": "Med Research storage domains, repositories, and export/import over DSH storage-domain",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*"
  },
  "dependencies": {
    "@medresearch/dsh-medical-contracts": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": "^0.1.3-alpha.2"
  }
}
