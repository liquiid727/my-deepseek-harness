{
  "name": "@medresearch/dsh-plugin-literature",
  "version": "1.1.0",
  "description": "Med Research literature plugin: PubMed E-utilities connector, query plans, and search tools",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*"
  },
  "dependencies": {
    "@medresearch/dsh-medical-contracts": "workspace:*",
    "@medresearch/dsh-medical-domain": "workspace:*",
    "@medresearch/dsh-medical-storage": "workspace:*",
    "@medresearch/dsh-medical-xml": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-web": "^0.1.3-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
