{
  "name": "@medresearch/dsh-plugin-paper",
  "version": "1.1.0",
  "description": "Med Research paper plugin: document parsing, section/paragraph persistence, and paper tools",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*"
  },
  "dependencies": {
    "@medresearch/dsh-medical-contracts": "workspace:*",
    "@medresearch/dsh-medical-domain": "workspace:*",
    "@medresearch/dsh-medical-storage": "workspace:*",
    "@medresearch/dsh-medical-xml": "workspace:*",
    "pdfjs-dist": "^6.3.289"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.3-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-web": "^0.1.3-alpha.2"
  }
}
