{
  "name": "@medresearch/dsh-plugin-medical-ui",
  "version": "1.1.0",
  "description": "Med Research client UI: views, tool cards, settings, Remote data layer, and zh/en dictionaries",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./client": { "types": "./src/client/index.tsx", "default": "./lib/client.js" },
    "./src/*": "./src/*"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "external": ["@deepseek-ai/dsh-client-ui-primitives"]
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": ["lib/client.js", "lib/client.js.map", "src/**/*"],
  "dependencies": { "@medresearch/dsh-medical-contracts": "workspace:*" },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../../../packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "link:../../../../packages/client/ui-sidebar-right"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-tool": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.3-alpha.2"
  }
}
